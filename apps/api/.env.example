# @dropcheck/api — copy to apps/api/.env.local and fill in.
#
# This process owns every secret in the system. The frontend
# (apps/web) holds none: it only knows the API's public URL.
#
# In production these are declared in ../../render.yaml: the four secret
# ones are `sync: false` (Render prompts for them once and stores the
# values), SESSION_SECRET is `generateValue: true` (Render mints it, so it
# never exists in a file), and the rest are plain values in that file.

# --- Supabase (Postgres) --------------------------------------------------
SUPABASE_URL=
# The service_role key from Supabase → Project Settings → API keys.
# NOT the anon / publishable key (RLS-restricted; upserts will fail).
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude Agent SDK ------------------------------------------------------
# Powers the whole advisor loop (system prompt + three MCP servers).
ANTHROPIC_API_KEY=

# --- App secrets -----------------------------------------------------------
# HMAC-SHA256 secret used to sign the anonymous `dropcheck_sid` cookie.
# Rotate to invalidate every existing session. Required when
# NODE_ENV=production — getSettings() throws rather than sign cookies
# with a value committed to this repo.
SESSION_SECRET=change-me-in-.env

# --- Cross-origin wiring ---------------------------------------------------
# Exact browser origins allowed to call this API with credentials.
# Comma-separate to cover Vercel preview URLs alongside production.
# Never a wildcard: browsers reject `Allow-Origin: *` together with
# `Allow-Credentials: true`, which is exactly our cookie setup.
WEB_ORIGIN=http://localhost:3000

# Set to true when the frontend is on a different origin than this API
# (i.e. Vercel ↔ Render). Switches the session cookie to
# `SameSite=None; Secure; Partitioned`. Leave unset locally — both apps
# are on localhost, so they're same-site and a Lax cookie is correct.
# Defaults to NODE_ENV === "production" when unset.
# COOKIE_CROSS_SITE=false

# --- Capacity --------------------------------------------------------------
# How many chat turns may run at once. Each one spawns a ~300 MB `claude`
# subprocess, so this is an out-of-memory guard, not a throughput dial:
# past this limit /api/chat answers 503 `server_busy` instead of taking
# the whole container down. Cloud Run had a platform flag for this
# (`--concurrency`); Render does not, so it lives in the app
# (apps/api/src/lib/gate.ts).
# Defaults to 1 — the safe floor for a 512 MB instance. Raise it only
# together with the instance size.
# MAX_CONCURRENT_TURNS=1
