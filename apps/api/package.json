{
  "name": "@dropcheck/api",
  "version": "0.1.0",
  "private": true,
  "description": "Academic Companion API — Hono server owning the Claude Agent SDK, three MCP servers, and Supabase.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "script:probe-rules": "tsx scripts/probeRulesEngineTools.ts",
    "script:ingest-purdue-cs": "tsx scripts/ingestPurdueCs.ts",
    "script:probe-agent": "tsx scripts/probeAgentSession.ts",
    "script:smoke-fallback": "tsx scripts/smokeFallback.ts",
    "script:smoke-e2e": "tsx scripts/smokeE2E.ts",
    "script:reset-students": "tsx scripts/resetStudentData.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "@anthropic-ai/sdk": "^0.115.0",
    "@dropcheck/shared": "*",
    "@hono/node-server": "^1.14.0",
    "@supabase/supabase-js": "^2.111.0",
    "cookie": "^2.0.1",
    "hono": "^4.7.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
