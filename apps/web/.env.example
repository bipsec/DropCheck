# @dropcheck/web — copy to apps/web/.env.local.
#
# The frontend holds no secrets. `NEXT_PUBLIC_` values are inlined into
# the browser bundle at build time, so anything here is public by
# definition — never put a key in this file.

# Base URL of the API (@dropcheck/api).
#   local dev  → http://localhost:8080   (npm run dev:api)
#   production → https://<service>.onrender.com
#
# Render's URL is derived from the service name in ../../render.yaml, so
# it's knowable before the first deploy — you can set this and the API's
# WEB_ORIGIN correctly on the first try, in either order.
#
# Leave empty to use relative URLs, which only works if something is
# serving the API on the same origin.
#
# NOTE: this is baked in at build time. Changing it in Vercel requires a
# redeploy, not just a restart.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
