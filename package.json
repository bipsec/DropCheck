{
  "name": "dropcheck",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @dropcheck/web",
    "dev:api": "npm run dev -w @dropcheck/api",
    "build": "npm run build -w @dropcheck/web",
    "start:api": "npm run start -w @dropcheck/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
