# DropCheck runs as a single Next.js app — no separate backend service.
# Copy this file to .env.local and fill in the values.

# --- Supabase (Postgres + pgvector + storage) ------------------------------
SUPABASE_URL=
# The service_role key from Supabase → Project Settings → API keys.
# NOT the anon / publishable key (RLS-restricted; upserts will fail).
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers ---------------------------------------------------------
# Claude — all agent orchestration (extraction, router, domain agents,
# synthesis, clarification, catalog matcher LLM disambiguation).
ANTHROPIC_API_KEY=
# OpenAI — used only for text-embedding-3-small on the catalog. We keep
# the Anthropic-only rule *for orchestration*; embeddings need 1536-dim
# vectors to match the existing pgvector column, and Anthropic doesn't
# ship an embedding model.
OPENAI_API_KEY=

# --- App secrets -----------------------------------------------------------
# HMAC-SHA256 secret used to sign the anonymous `dropcheck_sid` cookie.
# Rotate to invalidate every existing session.
SESSION_SECRET=change-me-in-.env

# Shared secret for the admin-only /api/catalog/upload endpoint.
ADMIN_SECRET=change-me-in-.env
