# --- Node / Next.js -------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Package managers -----------------------------------------------------
.npm/
.pnp.*
.yarn/
yarn.lock
pnpm-lock.yaml

# --- Test / coverage ------------------------------------------------------
coverage/
.nyc_output/
.vitest-cache/

# --- Env / secrets ---------------------------------------------------------
.env
.env.local
.env.*.local
*.local

# --- Logs ------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Editor / OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
plan/*
AGENTS.md
temp/*

# NOTE: `db/*` and `tests/*` used to be ignored here, which meant the SQL
# migrations and the whole test suite were untracked. Both now live under
# apps/api/ and are deliberately committed: a fresh Supabase project
# cannot be provisioned without the migrations, and the tests are the
# only verification story for the API/web split.
